# Create `.env` from this file once (see run_command.txt); do not recopy over an existing `.env`.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: vision-capable model. Defaults to gpt-4o.
# Other options: gpt-4o-mini, gpt-4.1, gpt-4.1-mini
OPENAI_MODEL=gpt-4o

# Optional: webcam index passed to cv2.VideoCapture. Defaults to 0.
CAMERA_INDEX=0
